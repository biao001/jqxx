# 远端原有
fatigue/data/
*.mp4
*.avi
.vscode/
# Claude Code 本地配置
.claude/

# 本地 HTTPS 开发证书
.certs/

# Python 缓存
__pycache__/
*.pyc
*.pyo

# 行为算法运行时输出（截图 / demo 视频）
behavior_algo/outputs/

# Local DMS backend runtime and secrets
backend/runtime/

# Python 虚拟环境
.venv/

# 训练运行产物
behavior_algo/runs/

# ultralytics 训练时自动下载到工作目录的预训练权重
behavior_algo/yolov8n.pt
behavior_algo/yolo26n.pt
behavior_algo/yolov8s.pt
behavior_algo/models/yolov8s.pt

# 模型备份(本地用，不入库)
behavior_algo/models/*.backup.pt
behavior_algo/models/unified.trial*.pt

# 所有数据集统一放在仓库根 datasets/ 下，整体不入库(源/派生/演示数据集均为大量图片，
# 用户在"模型与数据"页上传的图片+标注也在此)；仅保留顶层参考文档(.md/.yaml)。
# 数据集结构与 data.yaml 由后端 registry / 构建脚本自动创建。
/datasets/*
!/datasets/*.md
!/datasets/*.yaml
